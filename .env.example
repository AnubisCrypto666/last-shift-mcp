# Reference only - server/src/index.ts does not load .env automatically
# (no dotenv, no --env-file). Pass these as real shell environment
# variables when running `npm run dev`, e.g.:
#   MCP_ALLOWED_ORIGINS=localhost npm run dev
# Never commit an actual .env file if you create one for your own notes.

# server/ (all optional - defaults shown)
MCP_PORT=3000
# Hostnames only (no scheme), comma-separated - required for the browser
# client/ dev server (Vite on localhost) to pass Origin validation. Unset
# (the default) means every browser request is rejected with 403 Invalid
# Origin - browsers report this as a generic CORS error in the console,
# not as a 403, which can look like a code bug when it isn't.
MCP_ALLOWED_ORIGINS=localhost
# "recorded" replays reviewed fixture narration instead of calling Bedrock.
DEMO_MODE=
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
AWS_REGION=
