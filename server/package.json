{
  "name": "last-shift-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for Ostatnia Szychta (The Last Shift) - a time-pressured escape-room narrative engine, spec-compliant with MCP 2025-11-25 Streamable HTTP.",
  "type": "module",
  "scripts": {
    "build:view": "esbuild src/room/view/roomMapView.ts --bundle --format=iife --minify --tsconfig=tsconfig.view.json --outfile=build/roomMapView.bundle.js",
    "prebuild": "npm run build:view",
    "build": "tsc -p tsconfig.json",
    "predev": "npm run build:view",
    "dev": "tsx src/index.ts",
    "prestart": "npm run build:view",
    "start": "node dist/index.js",
    "pretest": "npm run build:view",
    "test": "vitest run",
    "pretest:watch": "npm run build:view",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1134.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "express": "5.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/express": "5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "7.2.1",
    "esbuild": "0.28.2",
    "supertest": "7.2.2",
    "tsx": "^4.19.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
