{
  "name": "last-shift-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for Ostatnia Szychta (The Last Shift) - a time-pressured escape-room narrative engine, spec-compliant with MCP 2025-11-25 Streamable HTTP.",
