  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsx": "^4.19.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
